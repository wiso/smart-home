# t3bench InfluxDB — write-only, TLS, token-auth, restricted to INFN-Milano + CERN.
# Only /api/v2/write and /health are proxied, and only from the allowlisted IPs;
# anything else -> 403. UI, token management and query stay off the internet.
https://influxdb.giurrero.duckdns.org {
	import https_header
	@ok {
		path /api/v2/write /health
		remote_ip 192.135.14.0/24 2001:760:4224::/48 137.138.0.0/16 128.141.0.0/16 128.142.0.0/16 188.184.0.0/15 194.12.128.0/18 2001:1458::/32 2001:1459::/32
	}
	handle @ok {
		reverse_proxy http://192.168.1.140:8086
	}
	handle {
		respond "forbidden" 403
	}
}
