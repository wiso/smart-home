#  When your config is ok comment block below to disable use of AMCE staging server
#{
#    acme_ca https://acme-staging-v02.api.letsencrypt.org/directory 
#}

(https_header) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubdomains"
		X-XSS-Protection "1; mode=block"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "same-origin"
	}
}

http://giurrero.duckdns.org:80 {
	respond "Hello world!"
	file_server
}

# Authelia - pagina di login
https://auth.giurrero.duckdns.org {
	import https_header
	reverse_proxy 192.168.1.140:9092
}

# Homepage - protetta da Authelia
https://giurrero.duckdns.org {
	import https_header
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email

		header_up X-Forwarded-Method {method}
		header_up X-Forwarded-Uri {uri}
	}
	reverse_proxy http://192.168.1.140:3002
}

# home assistant

https://ha.giurrero.duckdns.org {
	import https_header
	reverse_proxy http://192.168.1.140:8123
}

